        {
          "id": "6f455884-48a7-45cf-8b22-65b6b6935176",
          "name": "Stream MCP Tool Requests for a Workspace",
          "request": {
            "name": "Stream MCP Tool Requests for a Workspace",
            "description": {
              "content": "[Documentation](https://docs.dust.tt/docs/client-side-mcp-server)\nServer-Sent Events (SSE) endpoint that streams MCP tool requests for a workspace.\nThis endpoint is used by client-side MCP servers to listen for tool requests in real-time.\nThe connection will remain open and events will be sent as new tool requests are made.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "w",
                ":wId",
                "mcp",
                "requests"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "serverId",
                  "value": "<string>",
                  "description": "(Required) ID of the MCP server to filter events for"
                },
                {
                  "disabled": false,
                  "key": "lastEventId",
                  "value": "<string>",
                  "description": "ID of the last event to filter events for"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "wId",
                  "description": "(Required) ID of the workspace"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
          "response": [
            {
              "id": "761aa44d-b3f8-4efd-99f8-20fe3132583a",
              "name": "Connection established successfully. Events will be streamed in Server-Sent Events format.\nEach event will contain a tool request that needs to be processed by the MCP server.\n",
              "originalRequest": {
                "url": {
                  "path": [
                    "api",
