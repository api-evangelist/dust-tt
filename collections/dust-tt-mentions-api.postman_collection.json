          "request": {
            "name": "Get Mention Suggestions for a Conversation",
            "description": {
              "content": "Get suggestions for mentions (agents and users) based on a query string, scoped to a specific conversation.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "w",
                ":wId",
                "assistant",
                "conversations",
                ":cId",
                "mentions",
                "suggestions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "query",
                  "value": "<string>",
                  "description": "(Required) Search query string to filter suggestions"
                },
                {
                  "disabled": false,
                  "key": "select",
                  "value": "<string>",
                  "description": "Array of mention types to include. Can be \"agents\", \"users\", or both. If not provided, defaults to agents and users."
